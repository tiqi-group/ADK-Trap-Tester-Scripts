/* Trap Tester palette (templated: placeholder tokens filled by gui/theme.py).
   Interactive elements green, viewers red; light/dark share this template. */

QWidget {
    font-size: 12px;
    background: $window_bg;
    color: $text;
}

#menuBar {
    background: $menu_bg;
}

QPushButton[role="menu"] {
    background: transparent;
    color: $menu_text;
    border: none;
    padding: 6px 14px;
    font-size: 14px;
}
QPushButton[role="menu"]:checked {
    background: $menu_sel;
    border-radius: 4px;
}
QPushButton[role="menu"]:hover {
    background: $menu_hover;
    border-radius: 4px;
}

/* Interactive controls — green */
QPushButton[role="interactive"] {
    background: $accent;
    color: $accent_btn_text;
    border: 1px solid $accent_border;
    border-radius: 4px;
    padding: 5px 10px;
}
QPushButton[role="interactive"]:hover { background: $accent_hover; }
QPushButton[role="interactive"]:disabled {
    background: $accent_disabled_bg; color: $accent_disabled_text;
}

QGroupBox[role="interactive"] {
    border: 2px solid $accent;
    border-radius: 6px;
    /* side/bottom margins keep the border off the window edge (else clipped) */
    margin: 8px 3px 3px 3px;
    background: $accent_box_bg;
}
QGroupBox[role="interactive"]::title {
    subcontrol-origin: margin;
    left: 8px;
    color: $accent_title;
    font-weight: bold;
}

QListWidget[role="interactive"],
QLineEdit[role="interactive"] {
    border: 1px solid $accent;
    border-radius: 3px;
    background: $input_bg;
    color: $text;
}
QLabel[role="interactive"] { color: $accent_title; font-weight: bold; }
QLabel[role="section"] {
    color: $section;
    font-weight: bold;
    margin-top: 6px;
    border-bottom: 1px solid $accent;
}
/* Static unit box shown to the right of a settings input (not an input). */
QLabel[role="unit"] {
    color: $unit_text;
    background: $unit_bg;
    border: 1px solid $unit_border;
    border-radius: 3px;
    padding: 1px 5px;
    min-width: 20px;
}
QLabel[role="unit"]:disabled { color: $unit_text_disabled; }

/* Viewers — red */
QGroupBox[role="viewer"] {
    border: 2px solid $viewer;
    border-radius: 6px;
    /* side/bottom margins keep the border off the window edge (else clipped) */
    margin: 8px 3px 3px 3px;
}
QGroupBox[role="viewer"]::title {
    subcontrol-origin: margin;
    left: 8px;
    color: $viewer_title;
    font-weight: bold;
}
QLabel[role="viewer"] {
    border: 2px solid $viewer;
    border-radius: 4px;
    background: $viewer_box_bg;
    color: $viewer_title;
    padding: 6px;
    font-weight: bold;
}
/* Plot title shown above a matplotlib canvas (Qt label, not drawn on the axes). */
QLabel[role="plotTitle"] { color: $viewer_title; font-weight: bold; }
/* Warning strip above a layout canvas. */
QLabel[role="warning"] {
    color: $warn_text;
    background: $warn_bg;
    border: 1px solid $warn_border;
    border-radius: 4px;
    padding: 3px;
}
QPlainTextEdit[role="viewer"] {
    border: 2px solid $viewer;
    border-radius: 4px;
    background: $terminal_bg;
    color: $terminal_text;
    font-family: monospace;
}
FigureCanvasQTAgg[role="viewer"] {
    border: 2px solid $viewer;
    border-radius: 4px;
}
